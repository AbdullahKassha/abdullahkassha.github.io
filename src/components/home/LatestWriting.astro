---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="latest-writing" aria-labelledby="latest-writing-title">
  <header>
    <h2 id="latest-writing-title">Latest Writing</h2>
    <a href={`${basePath}/blog/`}>View all</a>
  </header>

  <ol>
    {
      posts.map((post) => (
        <li>
          <article>
            <FormattedDate date={post.data.date} />
            <h3>
              <a href={`${basePath}/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .latest-writing {
    width: 100%;
    padding: 30px 0 10px;
    border-top: 1px solid var(--paper-line);
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    color: var(--paper-ink);
    font-size: 1.15rem;
  }

  header a,
  h3 a {
    color: var(--paper-ink);
    text-decoration: none;
  }

  header a {
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
  }

  header a:hover,
  h3 a:hover {
    color: var(--paper-accent);
  }

  ol {
    display: grid;
    gap: 22px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  article {
    display: grid;
    gap: 7px;
  }

  article :global(time) {
    color: var(--paper-ink-faint);
    font-family: var(--font-ui-label);
    font-size: 0.76rem;
  }

  h3 {
    font-size: clamp(1.08rem, 2vw, 1.34rem);
    line-height: 1.4;
  }

  p {
    max-width: 68ch;
    color: var(--paper-ink-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 820px) {
    .latest-writing {
      padding-top: 24px;
    }
  }
</style>
