---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/figure/og-abdullah-kassha.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
  googleSiteVerification?: string;
}

const {
  title,
  description,
  image,
  structuredData,
  noIndex = false,
  googleSiteVerification,
} = Astro.props;
const { site, fonts } = await getSiteConfig();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconUrl = `${basePath}/favicon.svg?v=ak-2026-08`;
const shouldLoadCloudflareAnalytics = import.meta.env.PROD && process.env.GITHUB_ACTIONS === 'true';
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>
{noIndex && <meta name="robots" content="noindex" />}
{
  googleSiteVerification && (
    <meta name="google-site-verification" content={googleSiteVerification} />
  )
}
<link rel="icon" type="image/svg+xml" href={faviconUrl} sizes="any" />
{
  serializedStructuredData && (
    <script type="application/ld+json" set:html={serializedStructuredData} />
  )
}
{
  shouldLoadCloudflareAnalytics && (
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"033f9d8f5df94897a2913eb2cb8190db"}'
    />
  )
}
