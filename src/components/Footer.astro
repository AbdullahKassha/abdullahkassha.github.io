---
import { Rss } from 'lucide-astro';
import { getSiteConfig } from '../data/site';

const { site } = await getSiteConfig();
const rssHref = `${import.meta.env.BASE_URL}rss.xml`;
---

<footer>
  <p>&copy; {new Date().getFullYear()} {site.title}.{site.footerNote && ` ${site.footerNote}`}</p>
  <a href={rssHref} aria-label="RSS feed">
    <Rss size={18} stroke-width={1.9} aria-hidden="true" focusable="false" />
    <span>RSS</span>
  </a>
</footer>

<style>
  footer {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 3em 1em 6em;
    color: var(--paper-ink-faint);
    font-size: 0.88rem;
    text-align: center;
  }

  p {
    margin: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    color: var(--paper-ink-soft);
    text-decoration: none;
  }

  a:hover {
    color: var(--paper-accent);
  }
</style>
